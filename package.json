{
  "name": "tapdeploy",
  "version": "0.1.0",
  "description": "TapDeploy: one-click, browser-only deployment of prebuilt releases into your own Cloudflare account. Runs on Cloudflare Workers or Node.js.",
  "license": "MIT",
  "author": "lpyedge",
  "homepage": "https://github.com/lpyedge/TapDeploy#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lpyedge/TapDeploy.git"
  },
  "bugs": {
    "url": "https://github.com/lpyedge/TapDeploy/issues"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "predev:web": "node scripts/ensure-dev-deps.mjs",
    "dev:web": "vite",
    "predev:node": "node scripts/ensure-dev-deps.mjs",
    "dev:node": "tsx watch src/runtime/node.ts",
    "predev:workers": "node scripts/ensure-dev-deps.mjs && node scripts/ensure-wrangler-link.mjs",
    "dev:workers": "wrangler dev",
    "prebuild:web": "node scripts/ensure-dev-deps.mjs",
    "build:web": "vite build",
    "prebuild:node": "node scripts/ensure-dev-deps.mjs",
    "build:node": "node scripts/build-node.mjs",
    "prebuild:workers": "node scripts/ensure-dev-deps.mjs",
    "build:workers": "node scripts/build-workers.mjs",
    "prebuild": "node scripts/ensure-dev-deps.mjs",
    "build": "npm run build:web && npm run build:node && npm run build:workers",
    "generate:validator": "node scripts/generate-config-validator.mjs",
    "pretypecheck": "node scripts/ensure-dev-deps.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prelint": "node scripts/ensure-dev-deps.mjs",
    "lint": "eslint .",
    "pretest:unit": "node scripts/ensure-dev-deps.mjs",
    "test:unit": "vitest run tests/unit --passWithNoTests",
    "pretest:contracts": "node scripts/ensure-dev-deps.mjs && node scripts/ensure-wrangler-link.mjs",
    "test:contracts": "vitest run tests/contracts",
    "pretest:e2e": "node scripts/ensure-dev-deps.mjs && node scripts/ensure-wrangler-link.mjs",
    "test:e2e": "playwright test",
    "pretest": "node scripts/ensure-dev-deps.mjs && node scripts/ensure-wrangler-link.mjs",
    "test": "vitest run",
    "deps:install": "node scripts/ensure-dev-deps.mjs install",
    "deps:verify": "node scripts/ensure-dev-deps.mjs verify"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "@noble/hashes": "^2.4.0",
    "blake3-wasm": "2.1.5",
    "fflate": "^0.8.3",
    "hono": "^4.13.13",
    "jsonc-parser": "^3.3.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261010.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "globals": "^16.5.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261006.1": true
  }
}

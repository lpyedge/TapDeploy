{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/lpyedge/TapDeploy/main/schemas/tapdeploy.config.v3.schema.json",
  "title": "TapDeploy standalone project configuration v3 (prebuilt release ZIP)",
  "description": "Minimal author contract for the prebuilt-ZIP deploy flow. The release ZIP's final wrangler.jsonc is the deployment source of truth; this config only carries app identity, ZIP source, pre-authorized symbolic capabilities and opt-in advanced clauses (inputs/units/install). No scripts, hooks, commands, raw OAuth scopes or arbitrary endpoints can ever be expressed here.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "app",
    "source",
    "capabilities"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Optional: this schema's URL, for editor completion and validation."
    },
    "schemaVersion": {
      "const": 3
    },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 180,
          "pattern": "^[A-Za-z0-9](?!.*\\.\\.)[A-Za-z0-9._-]*(?:/[A-Za-z0-9][A-Za-z0-9._-]*)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "maxLength": 500
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaultUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "maxLength": 2048
        },
        "allowLocalZip": {
          "type": "boolean"
        },
        "expectedSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "allowLocalZip": {
                "const": false
              }
            },
            "required": [
              "allowLocalZip"
            ]
          },
          "then": {
            "required": [
              "defaultUrl",
              "expectedSha256"
            ],
            "properties": {
              "defaultUrl": true,
              "expectedSha256": true
            }
          }
        }
      ]
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "uniqueItems": true,
      "items": {
        "enum": [
          "workers",
          "pages",
          "r2",
          "d1",
          "kv",
          "queues",
          "hyperdrive",
          "vectorize",
          "secrets-store",
          "workers-ai",
          "browser-rendering",
          "routes",
          "dns",
          "zone",
          "workflows",
          "durable-objects"
        ]
      }
    },
    "units": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "wrangler"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/unitId"
          },
          "kind": {
            "enum": [
              "worker",
              "pages"
            ]
          },
          "wrangler": {
            "$ref": "#/$defs/wranglerPath"
          },
          "dependsOn": {
            "$ref": "#/$defs/dependsOn",
            "description": "Units deployed first. Resources always come first; this is only needed for an order TapDeploy cannot derive from service bindings."
          }
        }
      },
      "description": "Workers and Pages sites to deploy. Omit for one Worker or Pages site whose wrangler.jsonc is at the ZIP root (with `resources`: one Worker). An empty list means the release only creates `resources`."
    },
    "resources": {
      "type": "array",
      "maxItems": 16,
      "description": "Account resources the app uses, created before any Worker or Pages site is deployed. Name them here to control them: Workers bind them by name through their wrangler.jsonc.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "name"
        ],
        "properties": {
          "kind": {
            "enum": [
              "r2",
              "kv",
              "d1",
              "queue",
              "vectorize"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
            "description": "The suggested name; the user may rename it at install."
          },
          "create": {
            "type": "boolean",
            "description": "Create it when missing. Default true; false requires it to exist already."
          },
          "upgradeKeep": {
            "type": "boolean",
            "description": "Upgrade keeps the Worker bound to what it uses today. Default true; false lets the user bind another one (for replaceable data such as a cache, not a database)."
          },
          "dimensions": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1536,
            "description": "Vectorize only: vector size, required to create the index."
          },
          "metric": {
            "enum": [
              "cosine",
              "euclidean",
              "dot-product"
            ],
            "description": "Vectorize only: distance metric, required to create the index."
          }
        }
      }
    },
    "inputs": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "type",
          "label"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z][A-Za-z0-9._-]*$",
            "description": "Name of the Worker variable (a secret: the secret binding) the value is bound to. `workerName` is reserved: it names the Worker."
          },
          "type": {
            "enum": [
              "string",
              "text",
              "integer",
              "number",
              "boolean",
              "date",
              "secret",
              "select",
              "multiselect"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "description": {
            "type": "string",
            "maxLength": 500
          },
          "placeholder": {
            "type": "string",
            "maxLength": 200
          },
          "options": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                {
                  "type": "number"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "label",
                    "value"
                  ],
                  "properties": {
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "value": {
                      "type": [
                        "string",
                        "number",
                        "boolean"
                      ]
                    }
                  }
                }
              ]
            },
            "description": "Choices of a select / multiselect: plain values, or { label, value } objects."
          },
          "validation": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "minLength": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000
              },
              "maxLength": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000
              },
              "pattern": {
                "type": "string",
                "maxLength": 200
              },
              "minimum": {
                "type": "number"
              },
              "maximum": {
                "type": "number"
              },
              "values": {
                "type": "array",
                "maxItems": 64,
                "items": {
                  "type": [
                    "string",
                    "number"
                  ]
                }
              }
            }
          },
          "required": {
            "type": "boolean",
            "description": "Must be filled at install. Default true. On upgrade an empty value always keeps what is deployed."
          },
          "upgradeKeep": {
            "type": "boolean",
            "description": "Do not ask again on upgrade: the deployed value stays. Default false (upgrade shows the field; empty keeps the value)."
          },
          "generate": {
            "type": "boolean",
            "description": "Secret only: TapDeploy generates a random value once and the user never enters it. Default false."
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "enum": [
                    "select",
                    "multiselect"
                  ]
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "required": [
                "options"
              ],
              "properties": {
                "options": true
              }
            }
          },
          {
            "if": {
              "properties": {
                "generate": true
              },
              "required": [
                "generate"
              ]
            },
            "then": {
              "properties": {
                "type": {
                  "const": "secret"
                }
              },
              "required": [
                "type"
              ]
            }
          }
        ]
      }
    },
    "install": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policies"
      ],
      "properties": {
        "policies": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "unitId",
              "r2Binding",
              "rootSecret",
              "armSecret",
              "armValue",
              "ownerKey",
              "markerKey",
              "initialPasswordKey"
            ],
            "properties": {
              "kind": {
                "const": "private-r2-owner-bootstrap/v1"
              },
              "unitId": {
                "$ref": "#/$defs/unitId"
              },
              "r2Binding": {
                "$ref": "#/$defs/bindingName"
              },
              "rootSecret": {
                "$ref": "#/$defs/bindingName"
              },
              "armSecret": {
                "$ref": "#/$defs/bindingName"
              },
              "armValue": {
                "const": "yes"
              },
              "ownerKey": {
                "$ref": "#/$defs/objectKey"
              },
              "markerKey": {
                "$ref": "#/$defs/objectKey"
              },
              "initialPasswordKey": {
                "$ref": "#/$defs/objectKey"
              },
              "readinessPath": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^/[^\\s]*$"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "unitId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
    },
    "bindingName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
    },
    "objectKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!.*\\.\\.)(?!.*//)[A-Za-z0-9][A-Za-z0-9._/-]*$"
    },
    "wranglerPath": {
      "type": "string",
      "minLength": 7,
      "maxLength": 160,
      "pattern": "^(?!.*\\.\\.)(?!.*//)[A-Za-z0-9][A-Za-z0-9._/-]*\\.jsonc$"
    },
    "dependsOn": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/unitId"
      }
    }
  }
}

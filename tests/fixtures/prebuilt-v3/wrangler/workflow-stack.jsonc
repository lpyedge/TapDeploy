{
  // Workflow carrier: workflows + DO + migrations + services + ratelimits.
  "name": "sync-carrier",
  "main": "worker/main.mjs",
  "compatibility_date": "2026-10-10",
  "ratelimits": [
    { "name": "UPLOAD_LIMITER", "namespace_id": "1001", "simple": { "limit": 100, "period": 60 } }
  ],
  "workflows": [
    { "name": "sync-workflow", "binding": "SYNC_WORKFLOW", "class_name": "SyncWorkflow" }
  ],
  "durable_objects": {
    "bindings": [{ "name": "SYNC_STATE", "class_name": "SyncState" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SyncState"] }],
  "services": [
    { "binding": "AUTH_SERVICE", "service": "auth-worker", "environment": "production" }
  ],
  "rules": [{ "type": "CompiledWasm", "globs": ["**/*.wasm"] }]
}

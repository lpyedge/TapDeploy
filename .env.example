# TapDeploy instance settings. Copy to .env.local for local development, or to
# .env next to compose.yaml for Docker. Never commit a file with real values.

# The address users open: https://deploy.example.com, or with a port
# https://deploy.example.com:8443 (a trailing / is fine; http only for
# localhost). The OAuth client's redirect URL is <origin>/api/auth/callback.
PUBLIC_ORIGIN=http://localhost:8787

# The Cloudflare OAuth client (docs/self-hosting.md). The secret
# also derives the key that encrypts session cookies, so rotating it signs
# everyone out.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# Node runtime only: the port the server listens on (all interfaces).
PORT=8787

# TapDeploy instance settings. Copy to .env.local for local development, or to
# .env next to compose.yaml for Docker. Never commit a file with real values.

# Bare origin users reach (no trailing slash, no path). The OAuth client's
# redirect URL must be <origin>/api/auth/callback. Use https://<your-domain>
# for a shared instance; http is accepted only for localhost.
TAPDEPLOY_PUBLIC_ORIGIN=http://localhost:8787

# The Cloudflare OAuth client (docs/deployment/cloudflare-oauth.md). The secret
# also derives the key that encrypts session cookies, so rotating it signs
# everyone out.
TAPDEPLOY_OAUTH_CLIENT_ID=
TAPDEPLOY_OAUTH_CLIENT_SECRET=

# Node runtime only: the port the server listens on (all interfaces).
PORT=8787
